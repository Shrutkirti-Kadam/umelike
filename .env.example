# ── Auth.js ──────────────────────────────────────────────────────────
# Generate with:  openssl rand -base64 32
AUTH_SECRET=""

# ── Google OAuth (manual setup — see README "Google sign-in") ────────
# Create at https://console.cloud.google.com → APIs & Services → Credentials
#   Authorized JavaScript origin:  http://localhost:3000
#   Authorized redirect URI:       http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Database (Postgres) ──────────────────────────────────────────────
# Any Postgres works. A Supabase project's "Connection string → URI" drops
# straight in here (use the "Session" pooler string for local dev).
DATABASE_URL="postgresql://user:password@localhost:5432/kindred"

# ── Product launch countdown ────────────────────────────────────────
# ISO 8601 date and time. The authenticated dashboard displays a live
# days/hours/minutes/seconds countdown to this exact moment.
APP_LAUNCH_DATE="2026-10-01T00:00:00+05:30"
